{
  // Configurazione Cloudflare: pubblica il sito statico così com'è
  "name": "fccds",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  // Dominio del sito (zona fccds.it su Cloudflare)
  "routes": [
    { "pattern": "fccds.it", "custom_domain": true },
    { "pattern": "www.fccds.it", "custom_domain": true }
  ]
}
